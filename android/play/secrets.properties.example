# Copie para android/play/secrets.properties (fica fora do git) ou passe como -Pchave=valor,
# em ~/.gradle/gradle.properties ou como variável de ambiente (VARDREN_ADMOB_APPID, VARDREN_UPLOAD_STOREFILE...).
# Nunca coloque estes valores no repositório.

# AdMob (admob.google.com → Apps → seu app): ID do app e dos dois blocos de anúncio
vardren.admob.appId=ca-app-pub-0000000000000000~0000000000
vardren.admob.interstitial=ca-app-pub-0000000000000000/0000000000
vardren.admob.rewarded=ca-app-pub-0000000000000000/0000000000

# Play Console → Monetizar com o Play → Configuração da monetização → Licenciamento (chave pública em Base64)
vardren.play.licenseKey=

# Chave de upload (gerada por você; a Play App Signing guarda a chave final de assinatura)
vardren.upload.storeFile=/caminho/fora/do/repositorio/vardren-upload.jks
vardren.upload.storePassword=
vardren.upload.keyAlias=upload
vardren.upload.keyPassword=
